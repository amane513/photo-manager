# /srv/immich/app/.env の雛形。DB_PASSWORDだけはsetup-immich.shが対話入力で設定する。
UPLOAD_LOCATION=/srv/immich/data
DB_DATA_LOCATION=/srv/immich/postgres
MODEL_CACHE_LOCATION=/srv/immich/model-cache
ARCHIVE_LIBRARY_ROOT=/mnt/camera_archive/photo-library
IMMICH_LAN_BIND_ADDRESS=192.168.11.17
# 同じポートを127.0.0.1にもbindし、Tailscale Serveからだけ転送する。
IMMICH_PORT=2283
IMMICH_VERSION=v3.2.0
TZ=Asia/Tokyo
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_DEVICE_IDS=0
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
