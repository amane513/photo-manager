# ホストごとにコピーして値を設定する。パスワードはここへ書かない。
PRIMARY_STORAGE_UUID=
PRIMARY_STORAGE_FSTYPE=ext4
ARCHIVE_MOUNT=/mnt/camera_archive
# 年フォルダを置く正本のルート。ARCHIVE_MOUNT配下であること。Amazon Photosのバックアップ対象はこの1フォルダにする。
ARCHIVE_LIBRARY_ROOT=/mnt/camera_archive/photo-library
ARCHIVE_OWNER=
ARCHIVE_GROUP=
SMB_SHARE_NAME=CameraArchive
SMB_VALID_USER=
# Mac側の~/.ssh/configで接続確認済みのホスト名（IPではなくエイリアスを推奨）。
SSH_HOST=
# MacのSMBマウント（mount_smbfs/osascript）用。~/.ssh/configのエイリアスは解釈できないためIPまたはホスト名を直接指定する。
SMB_SERVER=
# Immichの実行時設定。LAN_BIND_ADDRESSはUbuntuホストの家庭内LAN側IPv4アドレスにする。
IMMICH_ROOT=/srv/immich
IMMICH_LAN_BIND_ADDRESS=
IMMICH_PORT=2283
IMMICH_VERSION=v3.2.0
